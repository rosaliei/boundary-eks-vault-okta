      "text": "Apply complete! Resources: 14 added, 0 changed, 0 destroyed.\n\nOutputs:\n\nboundary_worker_security_group_recommendation = \"Create a security group allowing egress to https://BB0C8B66351A596AC1A823FDBAF38F90.gr7.ap-southeast-1.eks.amazonaws.com on port 443\"\nboundary_worker_subnet_id = \"subnet-0eeadc451dd6ab302\"\ncluster_certificate_authority_data = <sensitive>\ncluster_endpoint = \"https://BB0C8B66351A596AC1A823FDBAF38F90.gr7.ap-southeast-1.eks.amazonaws.com\"\ncluster_name = \"hc-eks-cluster\"\ncluster_oidc_issuer_url = \"https://oidc.eks.ap-southeast-1.amazonaws.com/id/BB0C8B66351A596AC1A823FDBAF38F90\"\ncluster_oidc_provider_arn = \"arn:aws:iam::173310766280:oidc-provider/oidc.eks.ap-southeast-1.amazonaws.com/id/BB0C8B66351A596AC1A823FDBAF38F90\"\ncluster_security_group_id = \"sg-003ac064fad0ed8aa\"\nkubeconfig_command = \"aws eks update-kubeconfig --region ap-southeast-1 --name hc-eks-cluster --profile xxxx\"\nnat_gateway_ids = [\n  \"nat-0d421bb5ddb485755\",\n]\nnode_security_group_id = \"sg-00f7ccaf1d17aad48\"\nprivate_subnet_ids = [\n  \"subnet-0eeadc451dd6ab302\",\n  \"subnet-0ce8f2d308a351396\",\n  \"subnet-009b218375aa93373\",\n]\npublic_subnet_ids = [\n  \"subnet-0d24860d43aadd28a\",\n  \"subnet-094c0d80d41cc795c\",\n  \"subnet-06016c1874657f853\",\n]\nvpc_cidr_block = \"10.0.0.0/16\"\nvpc_id = \"vpc-0642cd1b6fe3748ef\"",
