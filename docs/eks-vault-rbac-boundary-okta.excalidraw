    {
      "id": "OErwcHzIrs1mdTmYlhvMb",
      "type": "text",
      "x": -1262.00391623834,
      "y": 1732.6990464541623,
      "width": 925.78125,
      "height": 7080,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
