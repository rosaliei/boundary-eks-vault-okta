      "updated": 1788597158208,
      "link": null,
      "locked": false,
      "text": "# -----------------------------------------------------------------------------\n# Kubernetes RBAC Configuration for Vault Dynamic Credentials\n#\n# This file creates three tiers of access for the demo application namespace:\n# - viewer:   Read-only access to common resources\n# - operator: Viewer + ability to manage deployments, services, configmaps\n# - admin:    Full access to all resources in the namespace\n#\n# Each tier has:\n# - Namespace (shared)\n# - ServiceAccount (one per role)\n# - Role (defines permissions)\n# - RoleBinding (connects ServiceAccount to Role)\n#\n# Vault's Kubernetes secrets engine will generate short-lived tokens for\n# these ServiceAccounts, providing dynamic, time-limited credentials.\n# -----------------------------------------------------------------------------\n\n---\n# =============================================================================\n# NAMESPACE\n# =============================================================================\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: demo-app\n  labels:\n    app.kubernetes.io/managed-by: \"terraform-vault\"\n    purpose: \"demo-application\"\n\n---\n# =============================================================================\n# VIEWER ROLE\n# Minimum access: read-only to common Kubernetes resources\n# Use case: Developers checking application status, logs, debugging\n# =============================================================================\n\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: vault-viewer\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"viewer\"\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: Role\nmetadata:\n  name: viewer\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"viewer\"\nrules:\n  # Read-only access to core resources\n  - apiGroups: [\"\"]\n    resources:\n      - pods\n      - pods/log\n      - services\n      - endpoints\n      - configmaps\n      - secrets       # Read-only secrets (consider restricting in production)\n      - events\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Read-only access to workload resources\n  - apiGroups: [\"apps\"]\n    resources:\n      - deployments\n      - replicasets\n      - statefulsets\n      - daemonsets\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Read-only access to networking resources\n  - apiGroups: [\"networking.k8s.io\"]\n    resources:\n      - ingresses\n      - networkpolicies\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Read-only access to autoscaling\n  - apiGroups: [\"autoscaling\"]\n    resources:\n      - horizontalpodautoscalers\n    verbs: [\"get\", \"list\", \"watch\"]\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: RoleBinding\nmetadata:\n  name: viewer-binding\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"viewer\"\nsubjects:\n  - kind: ServiceAccount\n    name: vault-viewer\n    namespace: demo-app\nroleRef:\n  kind: Role\n  name: viewer\n  apiGroup: rbac.authorization.k8s.io\n\n---\n# =============================================================================\n# OPERATOR ROLE\n# Standard access: can manage deployments, services, and configuration\n# Use case: DevOps engineers deploying and managing applications\n# =============================================================================\n\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: vault-operator\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"operator\"\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: Role\nmetadata:\n  name: operator\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"operator\"\nrules:\n  # Full access to pods (including exec for debugging)\n  - apiGroups: [\"\"]\n    resources:\n      - pods\n      - pods/log\n      - pods/exec\n      - pods/portforward\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Manage services and endpoints\n  - apiGroups: [\"\"]\n    resources:\n      - services\n      - endpoints\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Manage configmaps (application configuration)\n  - apiGroups: [\"\"]\n    resources:\n      - configmaps\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Read-only secrets (operators shouldn't create secrets directly)\n  - apiGroups: [\"\"]\n    resources:\n      - secrets\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # View events\n  - apiGroups: [\"\"]\n    resources:\n      - events\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Full access to deployments, replicasets\n  - apiGroups: [\"apps\"]\n    resources:\n      - deployments\n      - deployments/scale\n      - replicasets\n      - replicasets/scale\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Read-only for statefulsets, daemonsets (require admin for changes)\n  - apiGroups: [\"apps\"]\n    resources:\n      - statefulsets\n      - daemonsets\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Manage ingresses\n  - apiGroups: [\"networking.k8s.io\"]\n    resources:\n      - ingresses\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Read-only network policies\n  - apiGroups: [\"networking.k8s.io\"]\n    resources:\n      - networkpolicies\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Manage HPA\n  - apiGroups: [\"autoscaling\"]\n    resources:\n      - horizontalpodautoscalers\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: RoleBinding\nmetadata:\n  name: operator-binding\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"operator\"\nsubjects:\n  - kind: ServiceAccount\n    name: vault-operator\n    namespace: demo-app\nroleRef:\n  kind: Role\n  name: operator\n  apiGroup: rbac.authorization.k8s.io\n\n---\n# =============================================================================\n# ADMIN ROLE\n# Full access: complete control over namespace resources\n# Use case: Platform engineers, namespace owners, emergency access\n# =============================================================================\n\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: vault-admin\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"admin\"\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: Role\nmetadata:\n  name: admin\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"admin\"\nrules:\n  # Full access to all core API resources\n  - apiGroups: [\"\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to apps API group\n  - apiGroups: [\"apps\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to batch (jobs, cronjobs)\n  - apiGroups: [\"batch\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to networking\n  - apiGroups: [\"networking.k8s.io\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to autoscaling\n  - apiGroups: [\"autoscaling\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to policy (PodDisruptionBudgets)\n  - apiGroups: [\"policy\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # RBAC management within namespace\n  - apiGroups: [\"rbac.authorization.k8s.io\"]\n    resources:\n      - roles\n      - rolebindings\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: RoleBinding\nmetadata:\n  name: admin-binding\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"admin\"\nsubjects:\n  - kind: ServiceAccount\n    name: vault-admin\n    namespace: demo-app\nroleRef:\n  kind: Role\n  name: admin\n  apiGroup: rbac.authorization.k8s.io\n",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# -----------------------------------------------------------------------------\n# Kubernetes RBAC Configuration for Vault Dynamic Credentials\n#\n# This file creates three tiers of access for the demo application namespace:\n# - viewer:   Read-only access to common resources\n# - operator: Viewer + ability to manage deployments, services, configmaps\n# - admin:    Full access to all resources in the namespace\n#\n# Each tier has:\n# - Namespace (shared)\n# - ServiceAccount (one per role)\n# - Role (defines permissions)\n# - RoleBinding (connects ServiceAccount to Role)\n#\n# Vault's Kubernetes secrets engine will generate short-lived tokens for\n# these ServiceAccounts, providing dynamic, time-limited credentials.\n# -----------------------------------------------------------------------------\n\n---\n# =============================================================================\n# NAMESPACE\n# =============================================================================\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: demo-app\n  labels:\n    app.kubernetes.io/managed-by: \"terraform-vault\"\n    purpose: \"demo-application\"\n\n---\n# =============================================================================\n# VIEWER ROLE\n# Minimum access: read-only to common Kubernetes resources\n# Use case: Developers checking application status, logs, debugging\n# =============================================================================\n\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: vault-viewer\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"viewer\"\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: Role\nmetadata:\n  name: viewer\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"viewer\"\nrules:\n  # Read-only access to core resources\n  - apiGroups: [\"\"]\n    resources:\n      - pods\n      - pods/log\n      - services\n      - endpoints\n      - configmaps\n      - secrets       # Read-only secrets (consider restricting in production)\n      - events\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Read-only access to workload resources\n  - apiGroups: [\"apps\"]\n    resources:\n      - deployments\n      - replicasets\n      - statefulsets\n      - daemonsets\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Read-only access to networking resources\n  - apiGroups: [\"networking.k8s.io\"]\n    resources:\n      - ingresses\n      - networkpolicies\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Read-only access to autoscaling\n  - apiGroups: [\"autoscaling\"]\n    resources:\n      - horizontalpodautoscalers\n    verbs: [\"get\", \"list\", \"watch\"]\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: RoleBinding\nmetadata:\n  name: viewer-binding\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"viewer\"\nsubjects:\n  - kind: ServiceAccount\n    name: vault-viewer\n    namespace: demo-app\nroleRef:\n  kind: Role\n  name: viewer\n  apiGroup: rbac.authorization.k8s.io\n\n---\n# =============================================================================\n# OPERATOR ROLE\n# Standard access: can manage deployments, services, and configuration\n# Use case: DevOps engineers deploying and managing applications\n# =============================================================================\n\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: vault-operator\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"operator\"\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: Role\nmetadata:\n  name: operator\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"operator\"\nrules:\n  # Full access to pods (including exec for debugging)\n  - apiGroups: [\"\"]\n    resources:\n      - pods\n      - pods/log\n      - pods/exec\n      - pods/portforward\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Manage services and endpoints\n  - apiGroups: [\"\"]\n    resources:\n      - services\n      - endpoints\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Manage configmaps (application configuration)\n  - apiGroups: [\"\"]\n    resources:\n      - configmaps\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Read-only secrets (operators shouldn't create secrets directly)\n  - apiGroups: [\"\"]\n    resources:\n      - secrets\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # View events\n  - apiGroups: [\"\"]\n    resources:\n      - events\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Full access to deployments, replicasets\n  - apiGroups: [\"apps\"]\n    resources:\n      - deployments\n      - deployments/scale\n      - replicasets\n      - replicasets/scale\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Read-only for statefulsets, daemonsets (require admin for changes)\n  - apiGroups: [\"apps\"]\n    resources:\n      - statefulsets\n      - daemonsets\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Manage ingresses\n  - apiGroups: [\"networking.k8s.io\"]\n    resources:\n      - ingresses\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n\n  # Read-only network policies\n  - apiGroups: [\"networking.k8s.io\"]\n    resources:\n      - networkpolicies\n    verbs: [\"get\", \"list\", \"watch\"]\n\n  # Manage HPA\n  - apiGroups: [\"autoscaling\"]\n    resources:\n      - horizontalpodautoscalers\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: RoleBinding\nmetadata:\n  name: operator-binding\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"operator\"\nsubjects:\n  - kind: ServiceAccount\n    name: vault-operator\n    namespace: demo-app\nroleRef:\n  kind: Role\n  name: operator\n  apiGroup: rbac.authorization.k8s.io\n\n---\n# =============================================================================\n# ADMIN ROLE\n# Full access: complete control over namespace resources\n# Use case: Platform engineers, namespace owners, emergency access\n# =============================================================================\n\napiVersion: v1\nkind: ServiceAccount\nmetadata:\n  name: vault-admin\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"admin\"\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: Role\nmetadata:\n  name: admin\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"admin\"\nrules:\n  # Full access to all core API resources\n  - apiGroups: [\"\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to apps API group\n  - apiGroups: [\"apps\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to batch (jobs, cronjobs)\n  - apiGroups: [\"batch\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to networking\n  - apiGroups: [\"networking.k8s.io\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to autoscaling\n  - apiGroups: [\"autoscaling\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # Full access to policy (PodDisruptionBudgets)\n  - apiGroups: [\"policy\"]\n    resources: [\"*\"]\n    verbs: [\"*\"]\n\n  # RBAC management within namespace\n  - apiGroups: [\"rbac.authorization.k8s.io\"]\n    resources:\n      - roles\n      - rolebindings\n    verbs: [\"get\", \"list\", \"watch\", \"create\", \"update\", \"patch\", \"delete\"]\n---\napiVersion: rbac.authorization.k8s.io/v1\nkind: RoleBinding\nmetadata:\n  name: admin-binding\n  namespace: demo-app\n  labels:\n    app.kubernetes.io/component: \"rbac\"\n    rbac.vault.io/role: \"admin\"\nsubjects:\n  - kind: ServiceAccount\n    name: vault-admin\n    namespace: demo-app\nroleRef:\n  kind: Role\n  name: admin\n  apiGroup: rbac.authorization.k8s.io\n",
      "autoResize": true,
