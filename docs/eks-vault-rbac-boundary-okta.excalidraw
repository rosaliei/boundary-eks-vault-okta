      "seed": 1625990423,
      "version": 463,
      "versionNonce": 1735862041,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788599470148,
      "link": null,
      "locked": false,
      "text": "Deploy Boundary Worker in VPC\n\n# Use HCP Boundary's controller-generated auth token\n# Follow HCP docs for worker registration\nSecurity Group Requirements\nOutbound: 443 to HCP Boundary cluster\nOutbound: 443 to EKS cluster endpoint (within VPC)\nInbound: None required (worker initiates all connections)\n\nRegistration\nFollow HCP Boundary Worker Registration to register the worker with your HCP Boundary cluster.",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deploy Boundary Worker in VPC\n\n# Use HCP Boundary's controller-generated auth token\n# Follow HCP docs for worker registration\nSecurity Group Requirements\nOutbound: 443 to HCP Boundary cluster\nOutbound: 443 to EKS cluster endpoint (within VPC)\nInbound: None required (worker initiates all connections)\n\nRegistration\nFollow HCP Boundary Worker Registration to register the worker with your HCP Boundary cluster.",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
