      "isDeleted": false,
      "boundElements": [],
      "updated": 1787120284764,
      "link": null,
      "locked": false,
      "text": "DevOps-Macbook:BOUNDARY_RESEARCH k.sithi$ aws eks update-kubeconfig \\\n>   --region ap-southeast-1 \\\n>   --name kst-devops-eks-cluster \\\n>   --profile xxxx\nAdded new context arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster to /Users/k.sithi/.kube/config",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DevOps-Macbook:BOUNDARY_RESEARCH k.sithi$ aws eks update-kubeconfig \\\n>   --region ap-southeast-1 \\\n>   --name kst-devops-eks-cluster \\\n>   --profile xxxx\nAdded new context arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster to /Users/k.sithi/.kube/config",
