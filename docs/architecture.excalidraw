      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "TLS runs end to end between kubectl and the EKS API.",
      "originalText": "TLS runs end to end between kubectl and the EKS API.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 12
    },
    {
      "id": "text-68-501085430",
      "type": "text",
      "x": 40,
      "y": 748,
      "width": 858.0000000000001,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 25905232,
      "version": 1,
      "versionNonce": 1041449536,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every hop in between relays ciphertext it cannot read \u2014 which is why kubectl needs --tls-server-name and the cluster CA.",
      "originalText": "Every hop in between relays ciphertext it cannot read \u2014 which is why kubectl needs --tls-server-name and the cluster CA.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
      "id": "text-69-1784759832",
      "type": "text",
      "x": 40,
      "y": 776,
      "width": 643.5,
      "height": 16.25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1265133104,
      "version": 1,
      "versionNonce": 391578344,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The worker proves itself to Boundary, never to Kubernetes. It holds no cluster credential.",
      "originalText": "The worker proves itself to Boundary, never to Kubernetes. It holds no cluster credential.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
