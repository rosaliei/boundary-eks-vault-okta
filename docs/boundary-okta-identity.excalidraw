      ],
      "updated": 1787739006163,
      "link": null,
      "locked": false,
      "text": "You will also need to construct a Sign-out redirect URI by appending :3000 at the end of the HCP Boundary Cluster address. \nFor example, https://e58fe114-7624-431c-994d-b6670e90b03J.boundary.hashicorp.cloud:3000.",
      "fontSize": 92.86848958333333,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You will also need to construct a Sign-out redirect URI by appending :3000 at the end of the HCP Boundary Cluster address. \nFor example, https://e58fe114-7624-431c-994d-b6670e90b03J.boundary.hashicorp.cloud:3000.",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
