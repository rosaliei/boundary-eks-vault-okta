      "index": "bJ3",
      "roundness": null,
      "seed": 846585876,
      "version": 1141,
      "versionNonce": 149365884,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787737342273,
      "link": null,
      "locked": false,
      "text": "8. Configuration of OIDC\n\n--> In the Name field, enter the name for identification.\n--> In the Description field, enter a valid description value.\n--> Paste the https://accounts.google.com in the Issuer field, which is google issuer url and exclude .well-known/openid-configuration from the copied value.\n\n--> In the Client ID field, paste the Application ID value, which you have copied from Okta.\n--> In the Client Secret field, paste the value, which you have copied from okta\n--> In the Signing Algorithms field, select add to rs256.",
      "fontSize": 97.15795229415531,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8. Configuration of OIDC\n\n--> In the Name field, enter the name for identification.\n--> In the Description field, enter a valid description value.\n--> Paste the https://accounts.google.com in the Issuer field, which is google issuer url and exclude .well-known/openid-configuration from the copied value.\n\n--> In the Client ID field, paste the Application ID value, which you have copied from Okta.\n--> In the Client Secret field, paste the value, which you have copied from okta\n--> In the Signing Algorithms field, select add to rs256.",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
