      "updated": 1788359580828,
      "link": null,
      "locked": false,
      "text": "This Oauth 2.0 flow is called Authorization code\nflow with PKCE, Token Exchange between different platforms \nIf you are curious, please read it , this is very important concept\nhttps://supertokens.com/blog/authorization-code-flow-with-pkce",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This Oauth 2.0 flow is called Authorization code\nflow with PKCE, Token Exchange between different platforms \nIf you are curious, please read it , this is very important concept\nhttps://supertokens.com/blog/authorization-code-flow-with-pkce",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
