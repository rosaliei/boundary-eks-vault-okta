    {
      "id": "owTv3GlysBQ7Y2aTkNwja",
      "type": "text",
      "x": -4081.662281768339,
      "y": 11055.213637584146,
      "width": 8937.041015625,
      "height": 1049.3058847768773,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 2,
