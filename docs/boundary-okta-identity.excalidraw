    {
      "id": "_miu_GnB8nDrKPYNFC2mv",
      "type": "text",
      "x": 1969.7245374706836,
      "y": 15907.083848795352,
      "width": 9268.5,
      "height": 1334.704017857144,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "19K0XRR_WiFZk3-PZZgRZ"
      ],
      "frameId": null,
      "index": "bMWV",
      "roundness": null,
      "seed": 54087364,
      "version": 462,
      "versionNonce": 81422076,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787737695644,
      "link": null,
      "locked": false,
      "text": "NOTE VERY IMPORTANT: Claims Scopes\n\nScopes are what you request at authorization time; they determine which claims Google actually puts in the token. The OIDC ones:\n\nopenid — required, gets you sub\nemail — adds email, email_verified\nprofile — adds name, given_name, family_name, picture\n\nSo in that \"Claims Scopes\" box you'd typically add email and profile (openid is usually sent automatically by the tool).",
      "fontSize": 123.58370535714296,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE VERY IMPORTANT: Claims Scopes\n\nScopes are what you request at authorization time; they determine which claims Google actually puts in the token. The OIDC ones:\n\nopenid — required, gets you sub\nemail — adds email, email_verified\nprofile — adds name, given_name, family_name, picture\n\nSo in that \"Claims Scopes\" box you'd typically add email and profile (openid is usually sent automatically by the tool).",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
    {
      "id": "a1ffFbGWB5Td0nJJAsyA9",
      "type": "text",
      "x": 1968.9901624706836,
      "y": 17392.386527366776,
      "width": 6372.09375,
      "height": 148.30044642857155,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "19K0XRR_WiFZk3-PZZgRZ"
      ],
      "frameId": null,
      "index": "bMX",
      "roundness": null,
      "seed": 2807364,
      "version": 780,
      "versionNonce": 1155390276,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "p94IMSEhM-hc6JVaPFXkE",
          "type": "arrow"
        }
      ],
      "updated": 1787737724107,
      "link": null,
      "locked": false,
      "text": "Without claims, boundary will only add sub ( unique identity ) as user in boundary store",
      "fontSize": 123.58370535714296,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Without claims, boundary will only add sub ( unique identity ) as user in boundary store",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
    {
