      "updated": 1787738943714,
      "link": null,
      "locked": false,
      "text": "Add boundary cluster as origin\n\nMeaning google application will\naccept connections from this domain.",
      "fontSize": 146.25390625000023,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Add boundary cluster as origin\n\nMeaning google application will\naccept connections from this domain.",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
    {
      "id": "yqH1kFYVDH9S7XfKqK9J4",
      "type": "text",
      "x": -20577.505148805776,
      "y": 14331.436045021925,
      "width": 9268.5,
      "height": 1334.704017857144,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJP",
      "roundness": null,
      "seed": 109657576,
      "version": 330,
      "versionNonce": 333836228,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787737734641,
      "link": null,
      "locked": false,
      "text": "NOTE VERY IMPORTANT: Claims Scopes\n\nScopes are what you request at authorization time; they determine which claims Google actually puts in the token. The OIDC ones:\n\nopenid — required, gets you sub\nemail — adds email, email_verified\nprofile — adds name, given_name, family_name, picture\n\nSo in that \"Claims Scopes\" box you'd typically add email and profile (openid is usually sent automatically by the tool).",
      "fontSize": 123.58370535714296,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE VERY IMPORTANT: Claims Scopes\n\nScopes are what you request at authorization time; they determine which claims Google actually puts in the token. The OIDC ones:\n\nopenid — required, gets you sub\nemail — adds email, email_verified\nprofile — adds name, given_name, family_name, picture\n\nSo in that \"Claims Scopes\" box you'd typically add email and profile (openid is usually sent automatically by the tool).",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
