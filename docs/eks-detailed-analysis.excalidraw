      "seed": 1230309737,
      "version": 172,
      "versionNonce": 982604039,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787120284764,
      "link": null,
      "locked": false,
      "text": "DevOps-Macbook:BOUNDARY_RESEARCH k.sithi$ cat /Users/k.sithi/.kube/config\napiVersion: v1\nkind: Config\nclusters:\n- cluster:\n    certificate-authority-data: XXXXXXXX\n    server: https://2ABFCC7907750CD672C090DDBF326126.gr7.ap-southeast-1.eks.amazonaws.com\n  name: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\nusers:\n- name: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\n  user:\n    exec:\n      apiVersion: client.authentication.k8s.io/v1beta1\n      args:\n      - --region\n      - ap-southeast-1\n      - eks\n      - get-token\n      - --cluster-name\n      - kst-devops-eks-cluster\n      - --output\n      - json\n      command: aws\n      env:\n      - name: AWS_PROFILE\n        value: xxxx\ncontexts:\n- context:\n    cluster: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\n    user: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\n  name: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\ncurrent-context: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DevOps-Macbook:BOUNDARY_RESEARCH k.sithi$ cat /Users/k.sithi/.kube/config\napiVersion: v1\nkind: Config\nclusters:\n- cluster:\n    certificate-authority-data: XXXXXXXX\n    server: https://2ABFCC7907750CD672C090DDBF326126.gr7.ap-southeast-1.eks.amazonaws.com\n  name: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\nusers:\n- name: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\n  user:\n    exec:\n      apiVersion: client.authentication.k8s.io/v1beta1\n      args:\n      - --region\n      - ap-southeast-1\n      - eks\n      - get-token\n      - --cluster-name\n      - kst-devops-eks-cluster\n      - --output\n      - json\n      command: aws\n      env:\n      - name: AWS_PROFILE\n        value: xxxx\ncontexts:\n- context:\n    cluster: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\n    user: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\n  name: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster\ncurrent-context: arn:aws:eks:ap-southeast-1:173310766280:cluster/kst-devops-eks-cluster",
