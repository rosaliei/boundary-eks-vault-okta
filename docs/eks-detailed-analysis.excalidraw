      ],
      "updated": 1787048533732,
      "link": null,
      "locked": false,
      "text": "Note: For example, If you want to create stateful container in your cluster, you will need storage right, \nfor example, at least storage driver to connect to amazon ebs to provision volumes ... \n\nWell, in that case , by default, it won't work without those addons.\nBut you can install it later, i will skip.",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: For example, If you want to create stateful container in your cluster, you will need storage right, \nfor example, at least storage driver to connect to amazon ebs to provision volumes ... \n\nWell, in that case , by default, it won't work without those addons.\nBut you can install it later, i will skip.",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
