      "isDeleted": false,
      "boundElements": [],
      "updated": 1787120284764,
      "link": null,
      "locked": false,
      "text": "NOTE: These are sets of permission defined by AWS by default. If you want to adjust the permission then,\nYou have to understand k8s role,rolebindings,clusterrole,clusterrolebindings,service account\n\nThis is another story of k8s. You can check repository below to see my detailed analysis.",
      "fontSize": 47.67406627618002,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: These are sets of permission defined by AWS by default. If you want to adjust the permission then,\nYou have to understand k8s role,rolebindings,clusterrole,clusterrolebindings,service account\n\nThis is another story of k8s. You can check repository below to see my detailed analysis.",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null
    },
