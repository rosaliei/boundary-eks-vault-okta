      "versionNonce": 746013369,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Okta silently omits the groups claim when its filter matches nothing \u2014 the symptom is identical to 'not configured at all'.",
      "originalText": "Okta silently omits the groups claim when its filter matches nothing \u2014 the symptom is identical to 'not configured at all'.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 11
    },
    {
      "id": "text-93-1293384712",
      "type": "text",
      "x": 40,
      "y": 1362,
      "width": 916.3000000000001,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
