      "version": 1,
      "versionNonce": 1018232522,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Boundary evaluates group membership at login only. Every Okta change needs a full logout, or nothing appears to happen.",
      "originalText": "Boundary evaluates group membership at login only. Every Okta change needs a full logout, or nothing appears to happen.",
      "fontSize": 14,
      "fontFamily": 2,
