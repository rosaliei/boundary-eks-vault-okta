{"type": "excalidraw", "version": 2, "source": "https://excalidraw.com", "elements": [{"id": "T47taMU32CzHMiwh6pFT", "type": "text", "x": 60, "y": 0, "width": 691.2, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1459067014, "version": 1, "versionNonce": 1506039082, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "EKS + Boundary + Vault \u2014 command walkthrough (steps 3-8)", "originalText": "EKS + Boundary + Vault \u2014 command walkthrough (steps 3-8)", "fontSize": 32, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "zILFSDOOnSmLmXOxpNQ8", "type": "rectangle", "x": 60, "y": 120.0, "width": 44.65, "height": 34, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1194562006, "version": 1, "versionNonce": 1051568246, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false}, {"id": "pfF6JR4BhYiCI52zp5G8", "type": "text", "x": 74, "y": 125.0, "width": 11.72, "height": 24, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1397417089, "version": 1, "versionNonce": 1257172101, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "4", "fontSize": 20, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "zILFSDOOnSmLmXOxpNQ8", "originalText": "4", "autoResize": true, "lineHeight": 1.25}, {"id": "VwnjQIWIwK2MwS91Zefo", "type": "text", "x": 130, "y": 122.0, "width": 752.2, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 512569824, "version": 1, "versionNonce": 560143133, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "Step 3a+3b \u2014 Vault: install (dev mode) + token-minting rights", "originalText": "Step 3a+3b \u2014 Vault: install (dev mode) + token-minting rights", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "rj7FAdNE-NPC2O-ucDpN", "type": "text", "x": 130, "y": 171.0, "width": 874.2, "height": 250.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 265824967, "version": 1, "versionNonce": 1884597037, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "# dev mode = in-memory, auto-unsealed. Restart wipes 3c-3d. Demos only!\nhelm repo add hashicorp https://helm.releases.hashicorp.com\nhelm repo update\nhelm install vault hashicorp/vault \\\n  --namespace vault --create-namespace \\\n  --set \"server.dev.enabled=true\" \\\n  --set \"server.dev.devRootToken=root\" \\\n  --set \"injector.enabled=false\"\n\nkubectl -n vault rollout status statefulset/vault --timeout=180s", "originalText": "# dev mode = in-memory, auto-unsealed. Restart wipes 3c-3d. Demos only!\nhelm repo add hashicorp https://helm.releases.hashicorp.com\nhelm repo update\nhelm install vault hashicorp/vault \\\n  --namespace vault --create-namespace \\\n  --set \"server.dev.enabled=true\" \\\n  --set \"server.dev.devRootToken=root\" \\\n  --set \"injector.enabled=false\"\n\nkubectl -n vault rollout status statefulset/vault --timeout=180s", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "CGJElKAkBYApi3Jrukd5", "type": "text", "x": 160, "y": 435.0, "width": 825.4, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1789751440, "version": 1, "versionNonce": 1910940454, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 Without 3b: config succeeds, every credential request returns 403", "originalText": "\u26a0 Without 3b: config succeeds, every credential request returns 403", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "TAEWGK8vEK89QkDy22tS", "type": "text", "x": 130, "y": 482.0, "width": 923.0, "height": 425.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 806429638, "version": 1, "versionNonce": 304945865, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "# THE step everything else fails on: engine CREATES tokens via\n# TokenRequest API -> needs create on serviceaccounts/token\nkubectl create serviceaccount vault-auth -n kube-system\n\nkubectl apply -f - <<'EOF'\napiVersion: rbac.authorization.k8s.io/v1\nkind: ClusterRole\nmetadata:\n  name: vault-token-creator\nrules:\n  - apiGroups: [\"\"]\n    resources: [\"serviceaccounts/token\"]\n    verbs: [\"create\"]\nEOF\n\nkubectl create clusterrolebinding vault-token-creator-binding \\\n  --clusterrole=vault-token-creator --serviceaccount=kube-system:vault-auth", "originalText": "# THE step everything else fails on: engine CREATES tokens via\n# TokenRequest API -> needs create on serviceaccounts/token\nkubectl create serviceaccount vault-auth -n kube-system\n\nkubectl apply -f - <<'EOF'\napiVersion: rbac.authorization.k8s.io/v1\nkind: ClusterRole\nmetadata:\n  name: vault-token-creator\nrules:\n  - apiGroups: [\"\"]\n    resources: [\"serviceaccounts/token\"]\n    verbs: [\"create\"]\nEOF\n\nkubectl create clusterrolebinding vault-token-creator-binding \\\n  --clusterrole=vault-token-creator --serviceaccount=kube-system:vault-auth", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "FRPbpYbDsAbGJp1XBuOR", "type": "rectangle", "x": 60, "y": 997.0, "width": 44.65, "height": 34, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1157166984, "version": 1, "versionNonce": 1871056684, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false}, {"id": "iBTCdr9bQtB-chL2yL50", "type": "text", "x": 74, "y": 1002.0, "width": 11.72, "height": 24, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1344603493, "version": 1, "versionNonce": 1862085857, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "5", "fontSize": 20, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "FRPbpYbDsAbGJp1XBuOR", "originalText": "5", "autoResize": true, "lineHeight": 1.25}, {"id": "-ekbXBHTsudUJj0obyxc", "type": "text", "x": 130, "y": 999.0, "width": 764.4, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 268960508, "version": 1, "versionNonce": 492860472, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "Step 3c+3d+3e \u2014 Reach Vault, configure engine, roles, prove it", "originalText": "Step 3c+3d+3e \u2014 Reach Vault, configure engine, roles, prove it", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "SrIFlHtgwIhcSoETzJw8", "type": "text", "x": 130, "y": 1048.0, "width": 666.8, "height": 125.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1838851967, "version": 1, "versionNonce": 212830307, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "# ClusterIP is private -> port-forward (leave running)\nkubectl -n vault port-forward svc/vault 8200:8200\nexport VAULT_ADDR=http://127.0.0.1:8200\nexport VAULT_TOKEN=***\nvault status        # Sealed: false, Storage: inmem", "originalText": "# ClusterIP is private -> port-forward (leave running)\nkubectl -n vault port-forward svc/vault 8200:8200\nexport VAULT_ADDR=http://127.0.0.1:8200\nexport VAULT_TOKEN=***\nvault status        # Sealed: false, Storage: inmem", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "HxfFLEO6t90iIaVhGRVM", "type": "text", "x": 130, "y": 1203.0, "width": 1215.8, "height": 525.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 355452563, "version": 1, "versionNonce": 1868457662, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "vault secrets enable -path=kubernetes kubernetes\n\nTOKEN_REVIEW_JWT=$(kubectl create token vault-auth -n kube-system --duration=8760h)\nKUBE_CA=$(aws eks describe-cluster --name hc-eks-cluster \\\n  --region ap-southeast-1 --profile pegb \\\n  --query 'cluster.certificateAuthority.data' --output text | base64 -d)\n\nvault write kubernetes/config \\\n  kubernetes_host=\"https://BB0C8B66351A596AC1A823FDBAF38F90.gr7.ap-southeast-1.eks.amazonaws.com\" \\\n  kubernetes_ca_cert=\"$KUBE_CA\" \\\n  service_account_jwt=\"$TOKEN_REVIEW_JWT\" \\\n  disable_local_ca_jwt=true\n\n# one Vault role per SA - the link is the NAME STRING, nothing validates it\nfor R in viewer operator admin; do\n  vault write kubernetes/roles/$R \\\n    allowed_kubernetes_namespaces=\"demo-app\" \\\n    service_account_name=\"vault-$R\" \\\n    token_default_ttl=\"15m\" \\\n    token_max_ttl=\"1h\"\ndone", "originalText": "vault secrets enable -path=kubernetes kubernetes\n\nTOKEN_REVIEW_JWT=$(kubectl create token vault-auth -n kube-system --duration=8760h)\nKUBE_CA=$(aws eks describe-cluster --name hc-eks-cluster \\\n  --region ap-southeast-1 --profile pegb \\\n  --query 'cluster.certificateAuthority.data' --output text | base64 -d)\n\nvault write kubernetes/config \\\n  kubernetes_host=\"https://BB0C8B66351A596AC1A823FDBAF38F90.gr7.ap-southeast-1.eks.amazonaws.com\" \\\n  kubernetes_ca_cert=\"$KUBE_CA\" \\\n  service_account_jwt=\"$TOKEN_REVIEW_JWT\" \\\n  disable_local_ca_jwt=true\n\n# one Vault role per SA - the link is the NAME STRING, nothing validates it\nfor R in viewer operator admin; do\n  vault write kubernetes/roles/$R \\\n    allowed_kubernetes_namespaces=\"demo-app\" \\\n    service_account_name=\"vault-$R\" \\\n    token_default_ttl=\"15m\" \\\n    token_max_ttl=\"1h\"\ndone", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "dIeRGFqqmnC7ejIt5c0z", "type": "text", "x": 130, "y": 1758.0, "width": 837.6, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 999096350, "version": 1, "versionNonce": 1216545780, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "vault write kubernetes/creds/viewer kubernetes_namespace=demo-app\n# -> lease_id, lease_duration: 15m, service_account_token: eyJhbG...", "originalText": "vault write kubernetes/creds/viewer kubernetes_namespace=demo-app\n# -> lease_id, lease_duration: 15m, service_account_token: eyJhbG...", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "Npv2dC-qtAWV07qTseMp", "type": "text", "x": 160, "y": 1822.0, "width": 849.8, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 14175211, "version": 1, "versionNonce": 893375668, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 vault write, not read - the engine requires the namespace parameter", "originalText": "\u26a0 vault write, not read - the engine requires the namespace parameter", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "HWhRLBya645cirRJg9sU", "type": "text", "x": 160, "y": 1853.0, "width": 447.2, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1252359610, "version": 1, "versionNonce": 415477632, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 403 here means step 3b was skipped", "originalText": "\u26a0 403 here means step 3b was skipped", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "1RputGQ_S9orjGl9FezT", "type": "rectangle", "x": 60, "y": 1960.0, "width": 44.65, "height": 34, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 931983697, "version": 1, "versionNonce": 1969818669, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false}, {"id": "kT9zQOztS2OmIRACpHEg", "type": "text", "x": 74, "y": 1965.0, "width": 11.72, "height": 24, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 842366324, "version": 1, "versionNonce": 805732894, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "6", "fontSize": 20, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "1RputGQ_S9orjGl9FezT", "originalText": "6", "autoResize": true, "lineHeight": 1.25}, {"id": "x-cP_mRA0Nx2bjXuRHAI", "type": "text", "x": 130, "y": 1962.0, "width": 605.8, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1077545315, "version": 1, "versionNonce": 1080840972, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "Step 4 \u2014 Boundary worker: worker-led registration", "originalText": "Step 4 \u2014 Boundary worker: worker-led registration", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "h-FTwMwPDmKyQ3lQ-vt7", "type": "text", "x": 130, "y": 2011.0, "width": 1106.0, "height": 400.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1396474144, "version": 1, "versionNonce": 1629707367, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "# t3.micro in private subnet, no public IP, SSM only (boundary-worker.tf)\n# 1. read the auth request token off the instance\naws ssm start-session --target \\\n  $(terraform -chdir=terraform output -raw boundary_worker_instance_id) \\\n  --region ap-southeast-1 --profile pegb\nsudo /usr/local/bin/worker-auth-token\n\n# 2. activate it (from your laptop)\nexport BOUNDARY_ADDR=https://95390bdc-e040-47df-8638-7c996c0f98f7.boundary.hashicorp.cloud\nboundary authenticate\nboundary workers create worker-led \\\n  -name=kst-eks-ap-southeast-1-worker-01 \\\n  -worker-generated-auth-token=<TOKEN>\n\n# 3. confirm\nboundary workers list -scope-id global", "originalText": "# t3.micro in private subnet, no public IP, SSM only (boundary-worker.tf)\n# 1. read the auth request token off the instance\naws ssm start-session --target \\\n  $(terraform -chdir=terraform output -raw boundary_worker_instance_id) \\\n  --region ap-southeast-1 --profile pegb\nsudo /usr/local/bin/worker-auth-token\n\n# 2. activate it (from your laptop)\nexport BOUNDARY_ADDR=https://95390bdc-e040-47df-8638-7c996c0f98f7.boundary.hashicorp.cloud\nboundary authenticate\nboundary workers create worker-led \\\n  -name=kst-eks-ap-southeast-1-worker-01 \\\n  -worker-generated-auth-token=<TOKEN>\n\n# 3. confirm\nboundary workers list -scope-id global", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "IgzuKrELlrD7J997oUXR", "type": "text", "x": 160, "y": 2425.0, "width": 898.6, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1541862162, "version": 1, "versionNonce": 1489982371, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 name CANNOT be in worker.hcl (activation-token auth) - set it via -name", "originalText": "\u26a0 name CANNOT be in worker.hcl (activation-token auth) - set it via -name", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "VqNdxYhmuRk7FCL-IE11", "type": "text", "x": 160, "y": 2456.0, "width": 947.4, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 479662332, "version": 1, "versionNonce": 1820900114, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 'node is not yet authorized' on a loop = normal waiting state, not an error", "originalText": "\u26a0 'node is not yet authorized' on a loop = normal waiting state, not an error", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "d5T97zUBrf9Mhd1YPKK4", "type": "text", "x": 160, "y": 2487.0, "width": 923.0, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 570410808, "version": 1, "versionNonce": 214799181, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 worker dials OUT to HCP on 9202 through the NAT - that is the whole trick", "originalText": "\u26a0 worker dials OUT to HCP on 9202 through the NAT - that is the whole trick", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "IjDyIcREzMKZpEiiP8pY", "type": "rectangle", "x": 60, "y": 2594.0, "width": 44.65, "height": 34, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1177872369, "version": 1, "versionNonce": 726312749, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false}, {"id": "Wp93a4q1-Z9gwoESRfFF", "type": "text", "x": 74, "y": 2599.0, "width": 11.72, "height": 24, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 198255844, "version": 1, "versionNonce": 820024518, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "7", "fontSize": 20, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "IjDyIcREzMKZpEiiP8pY", "originalText": "7", "autoResize": true, "lineHeight": 1.25}, {"id": "WXFiUJXCG0pGjREiwZG0", "type": "text", "x": 130, "y": 2596.0, "width": 544.8, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1545496785, "version": 1, "versionNonce": 1881216669, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "Step 5 \u2014 Okta: app, groups, the groups claim", "originalText": "Step 5 \u2014 Okta: app, groups, the groups claim", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "uwS-ynw270-F4daHTYnI", "type": "text", "x": 130, "y": 2645.0, "width": 984.0, "height": 375.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1353087898, "version": 1, "versionNonce": 1311592603, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "5a. OIDC -> Web Application:\n   Sign-in redirect URI  https://<cluster>.boundary.hashicorp.cloud\n                        /v1/auth-methods/oidc:authenticate:callback\n   Sign-out redirect URI  https://<cluster>.boundary.hashicorp.cloud\n   Grant type             Authorization Code\n   -> note the Client ID (wrong app = every symptom looks identical)\n\n5b. Directory -> Groups: eks-viewers / eks-operators / eks-admins + assign users\n\n5c. Org auth server: Applications -> app -> Sign On\n    -> OpenID Connect ID Token -> Edit\n   Groups claim type:    FILTER (not Expression)\n   Groups claim filter:  groups  matches regex  eks-.*\n\nVerify with Token Preview: ID token must show \"groups\": [\"eks-viewers\"]", "originalText": "5a. OIDC -> Web Application:\n   Sign-in redirect URI  https://<cluster>.boundary.hashicorp.cloud\n                        /v1/auth-methods/oidc:authenticate:callback\n   Sign-out redirect URI  https://<cluster>.boundary.hashicorp.cloud\n   Grant type             Authorization Code\n   -> note the Client ID (wrong app = every symptom looks identical)\n\n5b. Directory -> Groups: eks-viewers / eks-operators / eks-admins + assign users\n\n5c. Org auth server: Applications -> app -> Sign On\n    -> OpenID Connect ID Token -> Edit\n   Groups claim type:    FILTER (not Expression)\n   Groups claim filter:  groups  matches regex  eks-.*\n\nVerify with Token Preview: ID token must show \"groups\": [\"eks-viewers\"]", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "xUnD5Exf8sRl8ftS_Z8c", "type": "text", "x": 160, "y": 3034.0, "width": 630.2, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1877652066, "version": 1, "versionNonce": 898050907, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 case-sensitive: EKS-Viewers will NOT match eks-.*", "originalText": "\u26a0 case-sensitive: EKS-Viewers will NOT match eks-.*", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "uBQTxexeSzGTJa-92GMc", "type": "text", "x": 160, "y": 3065.0, "width": 971.8, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 265573800, "version": 1, "versionNonce": 1513066114, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 assigning a user to a group does NOT put groups in the token - 5c is required", "originalText": "\u26a0 assigning a user to a group does NOT put groups in the token - 5c is required", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "_HmeL_cZIP7OIvHi0YMT", "type": "rectangle", "x": 60, "y": 3172.0, "width": 44.65, "height": 34, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 94260685, "version": 1, "versionNonce": 1350444197, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false}, {"id": "ATq7KnUpQP8ua11Gz0kw", "type": "text", "x": 74, "y": 3177.0, "width": 11.72, "height": 24, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1699164276, "version": 1, "versionNonce": 920964600, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "8", "fontSize": 20, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "_HmeL_cZIP7OIvHi0YMT", "originalText": "8", "autoResize": true, "lineHeight": 1.25}, {"id": "ReIEVZdgw4BDxlxrXJWw", "type": "text", "x": 130, "y": 3174.0, "width": 752.2, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1622470409, "version": 1, "versionNonce": 685518359, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "Step 6 \u2014 Boundary: scope, OIDC, managed groups, roles, target", "originalText": "Step 6 \u2014 Boundary: scope, OIDC, managed groups, roles, target", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "NlEj_RFankO1KhWBWVp0", "type": "text", "x": 130, "y": 3223.0, "width": 984.0, "height": 575.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 591352710, "version": 1, "versionNonce": 252662549, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "6a. Project scope 'eks-access'  +  DELETE the auto-created 'Default Grants' role\n\n6b. OIDC auth method (org scope):\n   Name okta-oidc | Issuer https://trial-9050012.okta.com\n   Client ID/Secret from 5a | RS256 | API URL prefix = cluster URL\n   audiences = Client ID | Claims scopes: profile, email, GROUPS\n   -> State: Active (public), make primary\n\n6c. Managed groups (recomputed at every login, never synced):\n   viewers   \"eks-viewers\"   in /token/groups\n   operators \"eks-operators\" in /token/groups\n   admins    \"eks-admins\"    in /token/groups\n\n6d. Roles (project scope, principals = managed groups):\n   viewer   ids=*;type=target;actions=list,no-op + authorize-session\n            ids=*;type=session;actions=list,read:self,cancel:self\n   operator + read on targets, list on host-catalog/host-set/host\n   admin    ids=*;type=<target|session|host-catalog|host-set|host>;actions=*\n            ids=*;type=<credential-store|credential-library>;actions=*\n\n6e. Static host catalog eks-hosts -> host eks-api (hostname, NOT IP)\n    -> host set eks-api-hosts -> target eks-api TCP:443, max 28800s\n    Egress worker filter: \"/name\" == \"kst-eks-ap-southeast-1-worker-01\"", "originalText": "6a. Project scope 'eks-access'  +  DELETE the auto-created 'Default Grants' role\n\n6b. OIDC auth method (org scope):\n   Name okta-oidc | Issuer https://trial-9050012.okta.com\n   Client ID/Secret from 5a | RS256 | API URL prefix = cluster URL\n   audiences = Client ID | Claims scopes: profile, email, GROUPS\n   -> State: Active (public), make primary\n\n6c. Managed groups (recomputed at every login, never synced):\n   viewers   \"eks-viewers\"   in /token/groups\n   operators \"eks-operators\" in /token/groups\n   admins    \"eks-admins\"    in /token/groups\n\n6d. Roles (project scope, principals = managed groups):\n   viewer   ids=*;type=target;actions=list,no-op + authorize-session\n            ids=*;type=session;actions=list,read:self,cancel:self\n   operator + read on targets, list on host-catalog/host-set/host\n   admin    ids=*;type=<target|session|host-catalog|host-set|host>;actions=*\n            ids=*;type=<credential-store|credential-library>;actions=*\n\n6e. Static host catalog eks-hosts -> host eks-api (hostname, NOT IP)\n    -> host set eks-api-hosts -> target eks-api TCP:443, max 28800s\n    Egress worker filter: \"/name\" == \"kst-eks-ap-southeast-1-worker-01\"", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "mrxcWhsysRIlUBNB3BzF", "type": "text", "x": 160, "y": 3812.0, "width": 862.0, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 396314363, "version": 1, "versionNonce": 2020416571, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 Default Grants gives list to u_auth = fake RBAC illusion - delete it", "originalText": "\u26a0 Default Grants gives list to u_auth = fake RBAC illusion - delete it", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "85-GPR12F6cGQ7i3tko1", "type": "text", "x": 160, "y": 3843.0, "width": 923.0, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1854353623, "version": 1, "versionNonce": 870299033, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 wildcard ids=* on a tier role = viewer authorizes eks-api-admin = privesc", "originalText": "\u26a0 wildcard ids=* on a tier role = viewer authorizes eks-api-admin = privesc", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "Pitmmc0RU-O-8q3jeF1J", "type": "text", "x": 160, "y": 3874.0, "width": 1093.8, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 363640584, "version": 1, "versionNonce": 1139562321, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 filter must match the REGISTERED name, else 'No egress workers can handle this session'", "originalText": "\u26a0 filter must match the REGISTERED name, else 'No egress workers can handle this session'", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "lbBRl6xhk7MbMoi2bwkS", "type": "rectangle", "x": 60, "y": 3981.0, "width": 44.65, "height": 34, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1613230573, "version": 1, "versionNonce": 1508251994, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false}, {"id": "y60k7zSPFbCq_wU7Gfd0", "type": "text", "x": 74, "y": 3986.0, "width": 11.72, "height": 24, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1718955517, "version": 1, "versionNonce": 1855657895, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "9", "fontSize": 20, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "lbBRl6xhk7MbMoi2bwkS", "originalText": "9", "autoResize": true, "lineHeight": 1.25}, {"id": "S-5RHiMd3XSXxiI2CEjT", "type": "text", "x": 130, "y": 3983.0, "width": 923.0, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1286448385, "version": 1, "versionNonce": 1223175152, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "Step 7 \u2014 Vault credential brokering (kills port-forward + admin kubeconfig)", "originalText": "Step 7 \u2014 Vault credential brokering (kills port-forward + admin kubeconfig)", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "-PPCJ1qHPDrrvC2LJ53Y", "type": "text", "x": 130, "y": 4032.0, "width": 1325.6, "height": 550.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 2121668049, "version": 1, "versionNonce": 2142582681, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "# 7a. internal NLB so the worker can reach Vault\nhelm upgrade vault hashicorp/vault -n vault --reuse-values \\\n  --set \"server.service.type=LoadBalancer\" \\\n  --set-string \"server.service.annotations.service\\\\.beta\\\\.kubernetes\\\\.io/aws-load-balancer-type=nlb\" \\\n  --set-string \"server.service.annotations.service\\\\.beta\\\\.kubernetes\\\\.io/aws-load-balancer-internal=true\"\n\n# 7b. scoped token for Boundary: periodic, orphan, renewable - NOT root\nvault policy write boundary-broker - <<'EOF'\npath \"kubernetes/creds/viewer\"   { capabilities = [\"create\", \"update\"] }\npath \"kubernetes/creds/operator\" { capabilities = [\"create\", \"update\"] }\npath \"kubernetes/creds/admin\"    { capabilities = [\"create\", \"update\"] }\npath \"sys/leases/renew\"          { capabilities = [\"update\"] }\npath \"sys/leases/revoke\"         { capabilities = [\"update\"] }\npath \"auth/token/renew-self\"     { capabilities = [\"update\"] }\npath \"auth/token/lookup-self\"    { capabilities = [\"read\"] }\nEOF\nvault token create -policy=boundary-broker -period=24h -orphan -renewable=true\n\n# 7c. credential store + libraries + ONE TARGET PER TIER (boundary/credentials.tf)\n#     library = POST kubernetes/creds/<tier> with namespace in the body\nviewer   role -> ids=ttcp_TbCSQnjLoW ; authorize-session\noperator role -> ids=ttcp_tGgVrCRMyJ ; authorize-session", "originalText": "# 7a. internal NLB so the worker can reach Vault\nhelm upgrade vault hashicorp/vault -n vault --reuse-values \\\n  --set \"server.service.type=LoadBalancer\" \\\n  --set-string \"server.service.annotations.service\\\\.beta\\\\.kubernetes\\\\.io/aws-load-balancer-type=nlb\" \\\n  --set-string \"server.service.annotations.service\\\\.beta\\\\.kubernetes\\\\.io/aws-load-balancer-internal=true\"\n\n# 7b. scoped token for Boundary: periodic, orphan, renewable - NOT root\nvault policy write boundary-broker - <<'EOF'\npath \"kubernetes/creds/viewer\"   { capabilities = [\"create\", \"update\"] }\npath \"kubernetes/creds/operator\" { capabilities = [\"create\", \"update\"] }\npath \"kubernetes/creds/admin\"    { capabilities = [\"create\", \"update\"] }\npath \"sys/leases/renew\"          { capabilities = [\"update\"] }\npath \"sys/leases/revoke\"         { capabilities = [\"update\"] }\npath \"auth/token/renew-self\"     { capabilities = [\"update\"] }\npath \"auth/token/lookup-self\"    { capabilities = [\"read\"] }\nEOF\nvault token create -policy=boundary-broker -period=24h -orphan -renewable=true\n\n# 7c. credential store + libraries + ONE TARGET PER TIER (boundary/credentials.tf)\n#     library = POST kubernetes/creds/<tier> with namespace in the body\nviewer   role -> ids=ttcp_TbCSQnjLoW ; authorize-session\noperator role -> ids=ttcp_tGgVrCRMyJ ; authorize-session", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "VkRvupESN8yB6LDoydPc", "type": "text", "x": 160, "y": 4596.0, "width": 752.2, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 331390334, "version": 1, "versionNonce": 1470525832, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 --set-string, not --set (plain --set = bool unmarshal fail)", "originalText": "\u26a0 --set-string, not --set (plain --set = bool unmarshal fail)", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "RcLXHddiSGOCQ9jJSeye", "type": "text", "x": 160, "y": 4627.0, "width": 1154.8, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 141848478, "version": 1, "versionNonce": 1191610249, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 tier enforced HERE: the credential comes from the target your role allows - nothing you type", "originalText": "\u26a0 tier enforced HERE: the credential comes from the target your role allows - nothing you type", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "Eqjg01nTi1pFfGLHmCuu", "type": "rectangle", "x": 60, "y": 4734.0, "width": 44.65, "height": 34, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 985664134, "version": 1, "versionNonce": 458920416, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false}, {"id": "eYvSBXkC5RE0GaFKYyKw", "type": "text", "x": 74, "y": 4739.0, "width": 11.72, "height": 24, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1858696191, "version": 1, "versionNonce": 908391552, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "10", "fontSize": 20, "fontFamily": 3, "textAlign": "center", "verticalAlign": "middle", "containerId": "Eqjg01nTi1pFfGLHmCuu", "originalText": "10", "autoResize": true, "lineHeight": 1.25}, {"id": "3E_KVgYI_QnuMMHMeuhb", "type": "text", "x": 130, "y": 4736.0, "width": 398.4, "height": 35.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1352527934, "version": 1, "versionNonce": 1748165550, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "Step 8 \u2014 End to end (the payoff)", "originalText": "Step 8 \u2014 End to end (the payoff)", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "mUxRjWUkc5G0FhlkNSMR", "type": "text", "x": 130, "y": 4785.0, "width": 1118.2, "height": 375.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1390152970, "version": 1, "versionNonce": 1793454771, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "export BOUNDARY_ADDR=https://95390bdc-e040-47df-8638-7c996c0f98f7.boundary.hashicorp.cloud\nboundary authenticate oidc -auth-method-id=amoidc_eY8ldrT0GG\n\n# terminal 1 - session AND credential in one command\nboundary connect -target-id=ttcp_TbCSQnjLoW -listen-port=8443 -format=json > /tmp/sess.json\n\n# terminal 2\nTOKEN=$(jq -r '.credentials[0].secret.decoded.service_account_token' /tmp/sess.json)\naws eks describe-cluster --name hc-eks-cluster --region ap-southeast-1 --profile pegb \\\n  --query 'cluster.certificateAuthority.data' --output text | base64 -d > /tmp/eks-ca.crt\n\nkubectl --server=https://127.0.0.1:8443 \\\n  --certificate-authority=/tmp/eks-ca.crt \\\n  --tls-server-name=BB0C8B66351A596AC1A823FDBAF38F90.gr7.ap-southeast-1.eks.amazonaws.com \\\n  --token=\"$TOKEN\" -n demo-app get pods", "originalText": "export BOUNDARY_ADDR=https://95390bdc-e040-47df-8638-7c996c0f98f7.boundary.hashicorp.cloud\nboundary authenticate oidc -auth-method-id=amoidc_eY8ldrT0GG\n\n# terminal 1 - session AND credential in one command\nboundary connect -target-id=ttcp_TbCSQnjLoW -listen-port=8443 -format=json > /tmp/sess.json\n\n# terminal 2\nTOKEN=$(jq -r '.credentials[0].secret.decoded.service_account_token' /tmp/sess.json)\naws eks describe-cluster --name hc-eks-cluster --region ap-southeast-1 --profile pegb \\\n  --query 'cluster.certificateAuthority.data' --output text | base64 -d > /tmp/eks-ca.crt\n\nkubectl --server=https://127.0.0.1:8443 \\\n  --certificate-authority=/tmp/eks-ca.crt \\\n  --tls-server-name=BB0C8B66351A596AC1A823FDBAF38F90.gr7.ap-southeast-1.eks.amazonaws.com \\\n  --token=\"$TOKEN\" -n demo-app get pods", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "8tVJhQXBLYPPy1YIJy09", "type": "text", "x": 130, "y": 5190.0, "width": 984.0, "height": 175.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1804626336, "version": 1, "versionNonce": 1420521278, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "Measured tiers (kubectl auth can-i through each tier's session):\n  tier      get pods | get secrets | create deploy | delete deploy | kube-system\n  viewer    yes      | yes         | no           | no            | no\n  operator  yes      | yes         | yes          | yes           | no\n  admin     yes      | yes         | yes          | yes           | no\n\nNO vault command. NO port-forward. NO admin kubeconfig.", "originalText": "Measured tiers (kubectl auth can-i through each tier's session):\n  tier      get pods | get secrets | create deploy | delete deploy | kube-system\n  viewer    yes      | yes         | no           | no            | no\n  operator  yes      | yes         | yes          | yes           | no\n  admin     yes      | yes         | yes          | yes           | no\n\nNO vault command. NO port-forward. NO admin kubeconfig.", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "xXv7qkFjsWZKzexefzKg", "type": "text", "x": 160, "y": 5379.0, "width": 947.4, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 417963671, "version": 1, "versionNonce": 1335286093, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 8443 = your laptop port (<1024 needs root); worker dials 443 at the far end", "originalText": "\u26a0 8443 = your laptop port (<1024 needs root); worker dials 443 at the far end", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "wZha-0t5Qo43oqtFMSdp", "type": "text", "x": 160, "y": 5410.0, "width": 776.6, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1944353497, "version": 1, "versionNonce": 127312264, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 web UI cannot open local ports - CLI or Boundary Desktop only", "originalText": "\u26a0 web UI cannot open local ports - CLI or Boundary Desktop only", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "T1SUBxi1Q17Lp1Xh5jmM", "type": "text", "x": 160, "y": 5441.0, "width": 654.6, "height": 25.0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1825410333, "version": 1, "versionNonce": 1560896229, "updated": 1788640883847, "isDeleted": false, "boundElements": [], "link": null, "locked": false, "text": "\u26a0 viewer CAN read secrets - see README Security notes", "originalText": "\u26a0 viewer CAN read secrets - see README Security notes", "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null, "scrollX": -90, "scrollY": -60, "zoom": {"value": 0.4}}, "files": {}}